# Copy to .env in the repo root, then fill in the values.
#   cp .env.docker.example .env
# .env is gitignored - safe to keep real keys there, never commit it.

# --- AI (Nova chatbot) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Primary model. Nova falls back to gemini-3.5-flash-lite / gemini-3.1-flash-lite
# if Gemini reports high demand.
GEMINI_MODEL=gemini-3.6-flash

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

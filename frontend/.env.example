# Base URL for the Learnova API.
# All backend routes live under /api, and the client appends /api automatically.
# You can set either the deployed origin or a base that already ends in /api.
# Examples:
#   VITE_API_URL=https://learnnova-6kaq.onrender.com
#   VITE_API_URL=https://learnnova-6kaq.onrender.com/api
#   VITE_API_URL=/api          (use the dev-server proxy in vite.config.js)
VITE_API_URL=https://learnnova-6kaq.onrender.com

# Copy this file to .env and fill in your real values.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB) ---
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=learnova
# Optional authentication (leave empty for a local instance without auth):
# DB_USER=
# DB_PASSWORD=
# Full connection string override (takes precedence over the values above):
# DB_URI=mongodb://127.0.0.1:27017/learnova

# --- Auth ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- AI (Nova chatbot) ---
# Create a key at https://aistudio.google.com/apikey
# Server-side only: the browser talks to /api/chat, never to Google directly.
GEMINI_API_KEY=your_gemini_api_key_here
# Primary model. If Gemini reports high demand, Nova automatically retries the
# fallback models below before giving up.
GEMINI_MODEL=gemini-3.6-flash